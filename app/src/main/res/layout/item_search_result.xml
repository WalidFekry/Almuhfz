<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSurahAyahTitle"
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jazeera"
            android:textColor="@color/primary_color"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="سورة البقرة - الآية 183" />

        <TextView
            android:id="@+id/tvAyahText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/quran"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_primary_color"
            android:textSize="20sp"
            tools:text="يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_stroke_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">



            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBookmarkAyah"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="14dp"
                android:text="حفظ علامة 🔖"
                android:textColor="@color/text_primary_color"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenAyah"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/button_green"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:text="انتقال واستماع 🔉"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
