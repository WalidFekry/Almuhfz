<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Surah Name + Status Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSurahName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jazeera"
                android:textColor="@color/text_primary_color"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="سورة الفاتحة" />

            <TextView
                android:id="@+id/tvStateBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="10dp"
                android:layout_marginStart="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="مكتملة ✔" />

        </LinearLayout>

        <!-- Subtitle: Reciter Name -->
        <TextView
            android:id="@+id/tvReciterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jazeera"
            android:textColor="@color/text_secondary_color"
            android:textSize="14sp"
            tools:text="القارئ أحمد العجمي" />

        <!-- Subtitle: File size & Ayahs count -->
        <TextView
            android:id="@+id/tvFileInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jazeera"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/text_secondary_color"
            android:textSize="12sp"
            tools:text="7/7 آية • 2.4 MB" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/itemProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            tools:progress="60"
            tools:visibility="visible" />

        <!-- Error Message View -->
        <TextView
            android:id="@+id/tvErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/jazeera"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:gravity="center"
            android:visibility="gone"
            tools:text="حدث خطأ أثناء تنزيل الآية رقم 3"
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_stroke_color" />

        <!-- Bottom Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/red"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:text="حذف"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResumeRetry"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/primary_color"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:text="استئناف"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPause"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:text="إيقاف مؤقت"
                android:textColor="@color/text_primary_color"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlayOffline"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/button_green"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:text="استماع"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
