<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/around_line3"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/around_line3"
            app:layout_collapseMode="pin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/TextAppearance.MyApp.Title.QiblahActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/jazeera"
                    android:gravity="end"
                    android:text="المصحف المعلم 🔉"
                    android:textColor="@color/text_on_primary" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_back_button"
                android:contentDescription="رجوع" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/reciterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_color"
        android:fontFamily="@font/jazeera"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/text_on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="القارئ أحمد العجمي - سورة الفاتحة" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ayasRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/aya_item_layout"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <com.example.jean.jcplayer.view.JcPlayerView
        android:id="@+id/jcplayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_dark"
        android:gravity="bottom"
        app:next_icon_color="@color/accent_gold"
        app:pause_icon_color="@color/accent_gold"
        app:play_icon_color="@color/accent_gold"
        app:previous_icon_color="@color/accent_gold"
        app:progress_color="@color/accent_gold"
        app:random_icon_color="@color/text_on_primary"
        app:repeat_icon_color="@color/text_on_primary"
        app:seek_bar_color="@color/text_on_primary"
        app:show_random_button="false"
        app:show_repeat_button="false"
        app:text_audio_current_duration_color="@color/accent_gold"
        app:text_audio_duration_color="@color/accent_gold"
        app:text_audio_title_color="@color/text_on_primary" />

</androidx.appcompat.widget.LinearLayoutCompat>
