<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_color"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_marginStart="5dp"
            android:layout_height="35dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/ic_back_button"
            />

        <!-- Reciter & Surah Name Banner -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/reciterName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/quran"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_on_primary"
            android:textSize="18sp"
            tools:text="القارئ أحمد العجمي - سورة الفاتحة" />
    </LinearLayout>



    <!-- Control Tools Bar (Bookmark, Font Size, Delay) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:elevation="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBookmarkCurrent"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/value_background"
            android:fontFamily="@font/jazeera"
            android:paddingHorizontal="8dp"
            android:text="حفظ 🔖"
            android:textColor="@color/text_primary_color"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRepeatInterval"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/value_background"
            android:fontFamily="@font/jazeera"
            android:paddingHorizontal="8dp"
            android:text="فاصل التكرار ⏱️"
            android:textColor="@color/text_primary_color"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFontCustomization"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/value_background"
            android:fontFamily="@font/jazeera"
            android:paddingHorizontal="8dp"
            android:text="الخط 🔤"
            android:textColor="@color/text_primary_color"
            android:textSize="12sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ayasRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        tools:listitem="@layout/aya_item_layout" />

    <com.example.jean.jcplayer.view.JcPlayerView
        android:id="@+id/jcplayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_dark"
        android:gravity="bottom"
        app:next_icon_color="@color/accent_gold"
        app:pause_icon_color="@color/accent_gold"
        app:play_icon_color="@color/accent_gold"
        app:previous_icon_color="@color/accent_gold"
        app:progress_color="@color/accent_gold"
        app:random_icon_color="@color/text_on_primary"
        app:repeat_icon_color="@color/text_on_primary"
        app:seek_bar_color="@color/text_on_primary"
        app:show_random_button="false"
        app:show_repeat_button="false"
        app:text_audio_current_duration_color="@color/accent_gold"
        app:text_audio_duration_color="@color/accent_gold"
        app:text_audio_title_color="@color/text_on_primary" />

</androidx.appcompat.widget.LinearLayoutCompat>
