<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".bookmarks.BookmarksActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/around_line3"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/around_line3"
            app:layout_collapseMode="pin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/toolbar_title"
                    style="@style/TextAppearance.MyApp.Title.QiblahActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/jazeera"
                    android:gravity="end"
                    android:text="العلامات والمحفوظات 🔖"
                    android:textColor="@color/text_on_primary" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_back_button"
                android:contentDescription="رجوع" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/primary_color"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="الكل"
                android:textColor="@color/text_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipHifz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="حفظ"
                android:textColor="@color/text_primary_color"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipMurajaa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="مراجعة"
                android:textColor="@color/text_primary_color"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipItqan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="إتقان"
                android:textColor="@color/text_primary_color"
                android:textSize="13sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookmarksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            tools:listitem="@layout/item_bookmark"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/bookmarksProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="لا توجد علامات"
                android:src="@drawable/ic_star"
                app:tint="@color/text_secondary_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jazeera"
                android:text="لا توجد علامات مرجعية حتى الآن"
                android:textColor="@color/text_primary_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jazeera"
                android:gravity="center"
                android:text="يمكنك إضافة الآيات إلى المحفوظات والملاحظات أثناء الاستماع في شاشة التعلم 🔖"
                android:textColor="@color/text_secondary_color"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
