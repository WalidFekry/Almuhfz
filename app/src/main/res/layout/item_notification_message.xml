<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Message Number -->
            <LinearLayout
                android:id="@+id/messageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:text="@string/message_num"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/message_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/primary_color"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </LinearLayout>

            <!-- Message Time -->
            <LinearLayout
                android:id="@+id/timeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:text="@string/message_time"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/message_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="14sp"
                    tools:text="12:00 AM" />
            </LinearLayout>

            <!-- Animation view -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/animation_view"
                android:layout_width="70dp"
                android:layout_height="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/messageInfo"
                app:lottie_autoPlay="true"
                app:lottie_fileName="data.json"
                app:lottie_loop="false" />

            <!-- Title / Body -->
            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/messages"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:padding="8dp"
                android:textColor="@color/text_primary_color"
                android:textSize="17sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/animation_view"
                tools:text="نص الاقتباس أو الرسالة التحفيزية" />

            <!-- Image Generation Actions Bar -->
            <LinearLayout
                android:id="@+id/imageActionsBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/title">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDownloadImage"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/value_background"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="6dp"
                    android:text="حفظ صورة 🖼️"
                    android:textColor="@color/text_primary_color"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnShareImage"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/value_background"
                    android:backgroundTint="@color/primary_color"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="6dp"
                    android:text="مشاركة صورة 🖼️"
                    android:textColor="@color/text_on_primary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnBookmarkMessage"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/value_background"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="6dp"
                    android:text="حفظ 🔖"
                    android:textColor="@color/text_primary_color"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Divider line -->
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/card_stroke_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imageActionsBar" />

            <!-- Text Share Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/starquran"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="6dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="favorite.json"
                    app:lottie_loop="false" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/sharequran"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="6dp"
                    app:lottie_autoPlay="true"
                    app:lottie_fileName="share.json"
                    app:lottie_loop="false" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/copyquran"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="6dp"
                    app:materialIcon="content_copy"
                    app:materialIconColor="@color/accent_gold"
                    app:materialIconSize="32dp" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/qumsgwhats"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="6dp"
                    app:materialIcon="whatsapp"
                    app:materialIconColor="#55CD6C"
                    app:materialIconSize="34dp" />

                <net.steamcrafted.materialiconlib.MaterialIconView
                    android:id="@+id/facebook_share"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_margin="6dp"
                    app:materialIcon="facebook_box"
                    app:materialIconColor="#0866FF"
                    app:materialIconSize="34dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
