<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".download.DownloadsActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/around_line3"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/around_line3"
            app:layout_collapseMode="pin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/toolbar_title"
                    style="@style/TextAppearance.MyApp.Title.QiblahActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/jazeera"
                    android:gravity="end"
                    android:text="@string/downloads_manager"
                    android:textColor="@color/text_on_primary" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_back_button"
                android:contentDescription="رجوع" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Summary Header Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteAll"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/value_background"
                    android:backgroundTint="@color/red"
                    android:fontFamily="@font/jazeera"
                    android:paddingHorizontal="12dp"
                    android:text="@string/delete_all_downloads"
                    android:textColor="@color/text_on_primary"
                    android:textSize="13sp" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="end"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTotalSpaceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jazeera"
                        android:text="@string/total_downloaded_space"
                        android:textColor="@color/text_secondary_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalSpace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/jazeera"
                        android:textColor="@color/primary_color"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="45.8 MB" />
                </LinearLayout>


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFailedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jazeera"
                    android:gravity="center"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="13sp"
                    tools:text="فشلت/متوقفة: 0" />


                <TextView
                    android:id="@+id/tvDownloadingCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jazeera"
                    android:gravity="center"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="13sp"
                    tools:text="جاري التحميل: 1" />

                <TextView
                    android:id="@+id/tvCompletedCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jazeera"
                    android:gravity="center"
                    android:textColor="@color/text_secondary_color"
                    android:textSize="13sp"
                    tools:text="المكتملة: 5" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Filter Chips / Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/primary_color"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/filter_all"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/filter_completed"
                android:textColor="@color/text_primary_color"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipDownloading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/filter_downloading"
                android:textColor="@color/text_primary_color"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chipFailed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/value_background"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/filter_failed"
                android:textColor="@color/text_primary_color"
                android:textSize="12sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/downloadsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            tools:listitem="@layout/item_download_surah"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/downloadsProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State Container -->
        <LinearLayout
            android:id="@+id/emptyStateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="@string/no_downloads_yet"
                android:src="@drawable/download"
                app:tint="@color/text_secondary_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/jazeera"
                android:text="@string/no_downloads_yet"
                android:textColor="@color/text_primary_color"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jazeera"
                android:gravity="center"
                android:text="@string/no_downloads_desc"
                android:textColor="@color/text_secondary_color"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGoMain"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/button_green"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="24dp"
                android:text="العودة للشاشة الرئيسية"
                android:textColor="@color/text_on_primary"
                android:textSize="15sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
