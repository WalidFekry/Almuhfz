<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Surah & Ayah + Category Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSurahAyahInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/jazeera"
                android:textColor="@color/primary_color"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="سورة البقرة - الآية 255" />

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/button_green"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="10dp"
                android:layout_marginStart="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="حفظ" />

        </LinearLayout>

        <!-- Ayah Text -->
        <TextView
            android:id="@+id/tvAyahText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/quran"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_primary_color"
            android:textSize="20sp"
            tools:text="اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ" />

        <!-- Optional Personal Note -->
        <TextView
            android:id="@+id/tvBookmarkNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_card_secondary"
            android:fontFamily="@font/jazeera"
            android:padding="8dp"
            android:textColor="@color/text_secondary_color"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="ملاحظة: تحتاج تركيز على المتشابهات في الربع الأخير"
            tools:visibility="visible" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/card_stroke_color" />

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeleteBookmark"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/red"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp"
                android:text="حذف"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlayAyah"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/value_background"
                android:backgroundTint="@color/button_green"
                android:fontFamily="@font/jazeera"
                android:paddingHorizontal="14dp"
                android:text="انتقال وتشغيل 🔉"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
