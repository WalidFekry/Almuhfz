<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".reminder.ReminderSettingsActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/around_line3"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/around_line3"
            app:layout_collapseMode="pin">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="end">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/toolbar_title"
                    style="@style/TextAppearance.MyApp.Title.QiblahActivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/jazeera"
                    android:gravity="end"
                    android:text="تذكير الورد اليومي ⏰"
                    android:textColor="@color/text_on_primary" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back_button"
                android:layout_width="40dp"
                android:layout_height="35dp"
                android:background="@drawable/ic_back_button"
                android:contentDescription="رجوع" />

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Toggle Switch -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchReminderEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jazeera"
                            android:text="تفعيل التذكير اليومي"
                            android:textColor="@color/text_primary_color"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/jazeera"
                            android:text="احصل على إشعار يومي لمراجعة وحفظ القرآن"
                            android:textColor="@color/text_secondary_color"
                            android:textSize="12sp" />
                    </LinearLayout>



                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2: Time Selection -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTimeSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jazeera"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="وقت التذكير اليومي 🕒"
                        android:textColor="@color/text_primary_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSelectTime"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/value_background"
                            android:fontFamily="@font/jazeera"
                            android:paddingHorizontal="16dp"
                            android:text="تغيير الوقت 🕒"
                            android:textColor="@color/text_primary_color"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/tvSelectedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/jazeera"
                            android:textColor="@color/primary_color"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="08:00 مساءً" />


                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 3: Reminder Message Style -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardMessageSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jazeera"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="صياغة الإشعار 💬"
                        android:textColor="@color/text_primary_color"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgMessageStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <RadioButton
                            android:id="@+id/rbMsgStyle0"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:fontFamily="@font/jazeera"
                            android:padding="6dp"
                            android:text="ورد القرآن الكريم 📖 (حان موعد وردك اليومي)"
                            android:textColor="@color/text_primary_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbMsgStyle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jazeera"
                            android:padding="6dp"
                            android:text="نور قلبك بالقرآن 🌟 (اقرءوا القرآن فإنه يأتي شفيماً)"
                            android:textColor="@color/text_primary_color"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbMsgStyle2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jazeera"
                            android:padding="6dp"
                            android:text="لا تهجر المصحف 🌿 (جدد عهدك مع كتاب الله)"
                            android:textColor="@color/text_primary_color"
                            android:textSize="13sp" />

                    </RadioGroup>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4: Battery Optimization / OEM Protection -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:layout_weight="1"
                            android:fontFamily="@font/jazeera"
                            android:text="ضمان وصول الإشعار (تجاهل تحسين البطارية) ⚡"
                            android:textColor="@color/text_primary_color"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvBatteryDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/jazeera"
                        android:text="بعض الهواتف (سامسونج، شاومي، هواوي، أوبو) تقوم بتجميد الإشعارات لتوفير البطارية. قم بتفعيل الاستثناء لضمان ظهور التذكير في وقته بدقة."
                        android:textColor="@color/text_secondary_color"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnBatteryOptimization"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/value_background"
                        android:fontFamily="@font/jazeera"
                        android:text="استثناء التطبيق من قيود البطارية 🔋"
                        android:textColor="@color/primary_color"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 5: Test Notification & Save Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTestNotification"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/value_background"
                    android:fontFamily="@font/jazeera"
                    android:text="تجربة إرسال إشعار الآن 🔔"
                    android:textColor="@color/text_primary_color"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveReminder"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/value_background"
                    android:backgroundTint="@color/button_green"
                    android:fontFamily="@font/jazeera"
                    android:text="حفظ الإعدادات 💾"
                    android:textColor="@color/text_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
